{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "size": "Medium", "wrap": true },
    { "type": "TextBlock", "text": "${updated}", "isSubtle": true, "size": "Small", "spacing": "None" },
    { "type": "TextBlock", "$when": "${empty}", "text": "Nothing from your data needs you, and nothing of yours is open.", "wrap": true, "isSubtle": true },
    {
      "type": "Container",
      "$data": "${rows}",
      "$when": "${!big || $host.widgetSize == 'large'}",
      "separator": true,
      "spacing": "Small",
      "selectAction": { "type": "Action.Execute", "verb": "open:${rid}" },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${text}", "wrap": false, "maxLines": 1 },
                { "type": "TextBlock", "text": "${sub}", "size": "Small", "color": "${color}", "weight": "${weight}", "spacing": "None", "wrap": false, "maxLines": 1 }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "ActionSet", "$when": "${mine}", "actions": [ { "type": "Action.Execute", "title": "Done", "verb": "done:${id}" } ] },
                { "type": "TextBlock", "$when": "${!mine}", "text": "App", "size": "Small", "isSubtle": true }
              ]
            }
          ]
        }
      ]
    },
    { "type": "TextBlock", "$when": "${more != '' && $host.widgetSize != 'large'}", "text": "${more}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Right" }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Open To-do", "verb": "open" },
    { "type": "Action.Execute", "title": "Add task", "verb": "add" }
  ]
}
